# =============================================
# AlcheMix II — .gitignore (Stack : SvelteKit 5 + Tauri 2 / Rust)
# =============================================

# --- Node / Vite / SvelteKit ---
node_modules/
dist/
build/
.svelte-kit/
*.local
.env
.env.*
!.env.example
.vite/

# --- Tauri / Rust (backend) ---
src-tauri/target/
src-tauri/gen/schemas/
src-tauri/gen/android/
src-tauri/gen/apple/
*.rs.bk
Cargo.lock.orig

# Locks intentionnellement commités pour apps binaires :
# src-tauri/Cargo.lock (gardé)

# --- Logs / caches ---
*.log
logs/
*.cache
.cache/
.vscode/.tsbuildinfo
tsconfig.tsbuildinfo

# --- IDE / éditeurs ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Packages temp / archives ---
*.tgz
*.gz
*.zip
*.rar

# --- Fichiers de développement ponctuels ---
*.old
*.bak

# --- Signature certificats locaux (NE JAMAIS committer) ---
alchemix_codesign.pfx
alchemix_codesign.cer
result.txt
build-*.log
tests_out.txt

# --- CodeGraph (graphe de code local, index SQLite) ---
.codegraph/
